{
  "name": "cloak",
  "productName": "Cloak Desktop",
  "version": "0.1.5",
  "private": true,
  "description": "FiveM server connector that keeps IP links inside the app.",
  "license": "UNLICENSED",
  "author": "Cloak",
  "repository": {
    "type": "git",
    "url": "https://github.com/realcaps04/Cloak.git"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:admin": "vite --mode admin --port 5175",
    "web": "vite --mode web --port 5174 --strictPort --open",
    "build": "vite build && electron-builder",
    "build:admin": "vite build --mode admin && electron-builder --config electron-builder.admin.json",
    "generate:appx-assets": "node scripts/generate-appx-assets.cjs",
    "build:store": "node scripts/generate-appx-assets.cjs && vite build && electron-builder --config electron-builder.store.json",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "convex": "^1.45.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
