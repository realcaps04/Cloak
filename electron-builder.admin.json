{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.cloak.admin",
  "productName": "Cloak Admin",
  "executableName": "CloakAdmin",
  "asar": true,
  "directories": {
    "output": "C:/Users/ASUS/AppData/Local/cloak-admin-release/${version}",
    "buildResources": "build"
  },
  "icon": "build/icon.png",
  "afterPack": "./scripts/afterPack.cjs",
  "files": [
    "dist-electron",
    "dist"
  ],
  "protocols": [
    {
      "name": "Cloak Admin",
      "schemes": ["cloak-admin"]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "signExecutable": false,
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "CloakAdmin.${ext}"
  }
}
